# promptwall environment variables.
# Copy this file to `.env` (gitignored) and fill in the values you need.
# All values are optional except OPENAI_API_KEY, which is required for any
# request that isn't blocked at the gateway.

# Upstream provider — defaults to OpenAI's public API.
OPENAI_API_KEY=sk-...
# PROMPTWALL_OPENAI_BASE_URL=https://api.openai.com/v1
# PROMPTWALL_OPENAI_TIMEOUT_SECONDS=60

# Database — defaults to the local docker-compose Postgres.
# PROMPTWALL_DATABASE_URL=postgresql+psycopg://promptwall:promptwall@localhost:5432/promptwall

# OpenTelemetry — defaults to the local docker-compose Jaeger.
# PROMPTWALL_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# PROMPTWALL_OTEL_SERVICE_NAME=promptwall

# Policy file — defaults to ../../policies/default.yaml resolved from the package.
# PROMPTWALL_POLICY_PATH=/abs/path/to/policy.yaml

# Logging.
# PROMPTWALL_LOG_LEVEL=INFO
# PROMPTWALL_LOG_RENDERER=json   # set to "console" for human-readable dev logs
